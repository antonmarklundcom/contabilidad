# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (preferred) or MySQL connection string.
DATABASE_URL="postgresql://facturapy:facturapy@localhost:5432/facturapy"

# ── Admin user (seeded on `npm run db:seed`) ────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# ── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── SIFEN ───────────────────────────────────────────────────────────────────
# mock  = no certificate needed, simulated SIFEN (default, safe)
# test  = real SIFEN homologación endpoints (requires certificate)
# production = real SIFEN production endpoints (requires certificate)
SIFEN_MODE="mock"
# Path to the .p12 digital certificate (only needed for test/production).
CERT_P12_PATH=""
# Password of the .p12 (only needed for test/production).
CERT_P12_PASSWORD=""
# Código de Seguridad del Contribuyente (issued by DNIT, used in the QR).
SIFEN_CSC=""
SIFEN_CSC_ID="0001"

# ── Receipt OCR (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Storage ─────────────────────────────────────────────────────────────────
# Directory for XML/KuDE/receipts/exports. Must persist across deploys.
STORAGE_DIR="./storage"

# ── Encryption at rest (certificate + its password) ─────────────────────────
# Generate with: openssl rand -hex 32  (must be 64 hex chars = 32 bytes)
ENCRYPTION_KEY=""

# ── SMTP (send KuDE + XML by email) ─────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Facturación <facturacion@example.com>"

# ── Cron ────────────────────────────────────────────────────────────────────
# External cron may call GET /api/cron with header "x-cron-secret: <value>".
CRON_SECRET="change-me-cron-secret"

# ── One-time invoice links (/e/[token]) ─────────────────────────────────────
# Key the link tokens are HMAC'd under. Optional: NEXTAUTH_SECRET is used when
# this is unset. Set it to rotate link signing independently of sessions —
# changing either invalidates every outstanding link, which is the intended
# emergency stop.
INVOICE_LINK_SECRET=""
# How long a freshly minted link stays redeemable, in minutes. Clamped to
# 5..1440; anything unparseable falls back to 30.
INVOICE_LINK_TTL_MINUTES="30"

# ── Hosts (PLAN Phase 9) ────────────────────────────────────────────────────
# One process serves two sites, split by the Host header:
#   sistema.contador.com.py  → the application (session-protected, noindex)
#   contador.com.py / www.   → the public marketing pages (indexable)
# Both defaults are built in, along with localhost/127.0.0.1 for development.
# Anything not on the app list is served marketing — an unknown host must
# never fall through to an app route without a session.
#
# Extra hostnames that serve the APPLICATION (staging, preview deployments).
# Comma- or space-separated. Adding a host here removes its login wall for
# nobody — it only decides which of the two sites answers.
APP_HOSTS=""
# Extra hostnames that serve the public site. Rarely needed: unknown hosts
# already fall back to marketing.
MARKETING_HOSTS=""
# Absolute origin used for canonical URLs and the sitemap.
MARKETING_SITE_URL="https://contador.com.py"

# ── Server ──────────────────────────────────────────────────────────────────
PORT="3000"

# DNIT padrón de contribuyentes (PLAN Phase 10). The folder URL that serves
# ruc0.zip … ruc9.zip, copied from DNIT's "Listado de RUC" page — not guessed
# here. Blank = no sync; supplier status checks stay silent.
PADRON_BASE_URL=""
